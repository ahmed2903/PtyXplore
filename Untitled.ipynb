 sans-serif !important;\\n}\\n\\n/* \\u2500\\u2500 Cards \\u2500\\u2500 */\\n.ptycho-card {\\n  background: var(--bg-card);\\n  border: 1px solid var(--border);\\n  border-radius: 12px;\\n  padding: 24px 28px;\\n  margin-bottom: 16px;\\n  position: relative;\\n  overflow: hidden;\\n}\\n.ptycho-card::before {\\n  content: '';\\n  position: absolute;\\n  top: 0; left: 0; right: 0;\\n  height: 3px;\\n  background: linear-gradient(90deg, var(--accent), var(--accent2));\\n}\\n\\n/* \\u2500\\u2500 Header \\u2500\\u2500 */\\n.dash-header {\\n  background: linear-gradient(135deg, #161B22 0%, #0A1628 100%);\\n  border-bottom: 1px solid var(--border);\\n  padding: 20px 32px;\\n  display: flex;\\n  align-items: center;\\n  gap: 16px;\\n}\\n.dash-title {\\n  font-size: 22px;\\n  font-weight: 800;\\n  letter-spacing: -0.5px;\\n  background: linear-gradient(90deg, var(--accent), var(--accent2));\\n  -webkit-background-clip: text;\\n  -webkit-text-fill-color: transparent;\\n  margin: 0;\\n}\\n.dash-sub {\\n  font-family: 'JetBrains Mono', monospace;\\n  font-size: 11px;\\n  color: var(--txt-muted);\\n  margin: 2px 0 0 0;\\n}\\n\\n/* \\u2500\\u2500 Section labels \\u2500\\u2500 */\\n.section-label {\\n  font-size: 11px;\\n  font-weight: 600;\\n  letter-spacing: 2px;\\n  text-transform: uppercase;\\n  color: var(--accent);\\n  margin: 0 0 14px 0;\\n  font-family: 'JetBrains Mono', monospace;\\n}\\n\\n/* \\u2500\\u2500 Status badge \\u2500\\u2500 */\\n.badge {\\n  display: inline-block;\\n  padding: 3px 10px;\\n  border-radius: 20px;\\n  font-size: 11px;\\n  font-family: 'JetBrains Mono', monospace;\\n  font-weight: 600;\\n  letter-spacing: 0.5px;\\n}\\n.badge-ok  { background: rgba(0,201,167,0.15); color: var(--accent); border: 1px solid rgba(0,201,167,0.3); }\\n.badge-err { background: rgba(255,107,107,0.15); color: var(--warn);   border: 1px solid rgba(255,107,107,0.3); }\\n.badge-idle{ background: rgba(139,148,158,0.15); color: var(--txt-muted); border: 1px solid rgba(139,148,158,0.3); }\\n\\n/* \\u2500\\u2500 Stat chips \\u2500\\u2500 */\\n.stat-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));\\n  gap: 12px;\\n  margin-top: 12px;\\n}\\n.stat-chip {\\n  background: var(--bg-mid);\\n  border: 1px solid var(--border);\\n  border-radius: 8px;\\n  padding: 12px 14px;\\n}\\n.stat-chip .val {\\n  font-family: 'JetBrains Mono', monospace;\\n  font-size: 18px;\\n  font-weight: 600;\\n  color: var(--accent);\\n  line-height: 1;\\n}\\n.stat-chip .lbl {\\n  font-size: 11px;\\n  color: var(--txt-muted);\\n  margin-top: 4px;\\n  text-transform: uppercase;\\n  letter-spacing: 1px;\\n}\\n\\n/* \\u2500\\u2500 Log panel \\u2500\\u2500 */\\n.log-box {\\n  background: var(--bg-dark);\\n  border: 1px solid var(--border);\\n  border-radius: 8px;\\n  padding: 14px 16px;\\n  font-family: 'JetBrains Mono', monospace;\\n  font-size: 12px;\\n  line-height: 1.7;\\n  color: var(--txt-muted);\\n  max-height: 280px;\\n  overflow-y: auto;\\n}\\n.log-ok   { color: #00C9A7; }\\n.log-err  { color: #FF6B6B; }\\n.log-info { color: #79C0FF; }\\n.log-warn { color: #E3B341; }\\n\\n/* \\u2500\\u2500 Widget overrides \\u2500\\u2500 */\\n.bk-input, .bk-select {\\n  background: var(--bg-mid) !important;\\n  border: 1px solid var(--border) !important;\\n  color: var(--txt) !important;\\n  border-radius: 6px !important;\\n  font-family: 'JetBrains Mono', monospace !important;\\n  font-size: 13px !important;\\n}\\n.bk-input:focus { border-color: var(--accent) !important; outline: none !important; }\\n\\n.bk-btn-primary {\\n  background: linear-gradient(135deg, var(--accent), #00A88A) !important;\\n  border: none !important;\\n  color: #000 !important;\\n  font-weight: 700 !important;\\n  font-family: 'Syne', sans-serif !important;\\n  letter-spacing: 0.5px !important;\\n  border-radius: 8px !important;\\n  transition: transform 0.15s, box-shadow 0.15s !important;\\n}\\n.bk-btn-primary:hover {\\n  transform: translateY(-1px) !important;\\n  box